# =============================================================================
# Career Guidance AI - Environment Template (SINGLE .env)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This is the ONLY env file. Frontend VITE_* vars also live here
# (Vercel dashboard + docker build-args consume them). Deleted files whose
# keys were merged here: .env.docker, frontend/.env,
# frontend/.env.production, deploy/aws/.env.aws.example,
# deploy/gcp/.env.gcp.example.
#
# Environment is AUTO-DETECTED at startup from PG_HOST:
#   - Contains "supabase.co"  -> Supabase (cloud, SSL enforced automatically)
#   - localhost / 127.0.0.1   -> Local PostgreSQL
#   - PG_HOST not set          -> Startup error (PostgreSQL is required)
# =============================================================================

# =============================================================================
# DATABASE - PostgreSQL / Supabase pooler (external; compose has no db service)
# Local: PG_HOST=localhost PG_PORT=5432
# Supabase pooler: host aws-1-<region>.pooler.supabase.com, port 6543,
#   user postgres.<project-ref>, db postgres
# =============================================================================
PG_HOST=
PG_PORT=
PG_USER=
PG_PASSWORD=
PG_DB=
# Alt connection path (optional): explicit DSN wins over the PG_* parts above.
# DATABASE_URL (Render/Supabase style, e.g. postgresql://user:pass@host:port/db)
# is normalized onto PG_DSN by config.py. Prefer PG_* parts (quote_plus-safe).
PG_DSN=
DATABASE_URL=

# =============================================================================
# ADMIN SEEDING (backend creates a verified active admin on startup when set)
# ADMIN_PASSWORD is plaintext in the environment and is hashed at seeding
# time with bcrypt; it is never logged. Leave both empty to disable seeding.
# =============================================================================
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=
API_PORT=

# =============================================================================
# RUNTIME ENV + JWT AUTH
# Generate a strong key with: openssl rand -hex 32
# APP_ENV=production enforces SECRET_KEY >= 32 chars at startup.
# =============================================================================
APP_ENV=
SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# =============================================================================
# AI SERVICES (Oct 2026 cutover: DeepSeek-via-OpenCode for ALL chat workloads,
# Groq for STT only.)
# Groq:   https://console.groq.com/keys
# =============================================================================
GROQ_API_KEY=
# STT model (transcribe_audio → Groq Whisper). Blank = config.py default
# (whisper-large-v3). There are no Groq chat-model keys: chat routes to
# opencode only.
GROQ_STT_MODEL=

# =============================================================================
# OPENCODE (OpenAI-compatible LLM provider, e.g. OpenCode Zen)
# Base URL default (config.py): https://opencode.ai/zen/v1  (Zen docs list per-
# model endpoints as https://opencode.ai/zen/v1/chat/completions).
# Default model (config.py): deepseek-v4.1-flash.
# Cutover: chat + explanation already default to opencode/DeepSeek in config.py,
# so these slots only need setting to OVERRIDE. There is NO fallback: each
# capability resolves to its single primary provider and a failure raises
# (callers own their recovery: question bank, template, offline explanation).
# =============================================================================
OPENCODE_API_BASE_URL=
OPENCODE_API_KEY=
OPENCODE_CHAT_MODEL=

# Capability slots (model-agnostic selection; provider names: groq,
# opencode). Empty *_NAME = legacy provider default.
# Cutover defaults (config.py): chat + explanation primary = opencode /
# deepseek-v4.1-flash. STT stays groq (Whisper). Swap providers via env
# only — no code changes.
MODEL_CHAT_PRIMARY_PROVIDER=
MODEL_CHAT_PRIMARY_NAME=
MODEL_EXPLAIN_PRIMARY_PROVIDER=
MODEL_EXPLAIN_PRIMARY_NAME=
MODEL_STT_PROVIDER=
MODEL_STT_NAME=

# =============================================================================
# YOUTUBE DATA API v3 (Learning Path video discovery) — single key.
# Quota-exhausted responses fall back to the LLM-template path.
# =============================================================================
YOUTUBE_DATA_API_KEY=

# =============================================================================
# GOOGLE SEARCH API (skill taxonomy builder)
# GOOGLE_SEARCH_API_KEY is a legacy alias for GOOGLE_API_KEY; GOOGLE_CSE_ID is
# a legacy alias for GOOGLE_SEARCH_ENGINE_ID (config.py falls back to both).
# =============================================================================
GOOGLE_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_CSE_ID=

# =============================================================================
# GOOGLE OAUTH2 + FRONTEND/BACKEND URLS + CORS
# Frontend stays on Vercel; backend CORS must list the Vercel URL.
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=
FRONTEND_URL=
CORS_ORIGINS=

# =============================================================================
# EMAIL - Gmail SMTP (verification emails; blank disables in dev)
# Use an App Password, NOT your Gmail password:
# https://support.google.com/accounts/answer/185833
# =============================================================================
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Verification code tuning (blank = code defaults: 6 digits / 30 minutes).
VERIFICATION_CODE_LENGTH=
VERIFICATION_CODE_TTL_MINUTES=
# Password-reset codes are shorter-lived than verification codes
# (blank = code default: 10 minutes; 6-digit reset codes are takeover-sensitive).
PASSWORD_RESET_CODE_TTL_MINUTES=

# =============================================================================
# EMBEDDINGS + SEMANTIC SKILL MATCHING (blank = config.py defaults)
# =============================================================================
# Offline MiniLM only (legacy cloud embedding path removed).
EMBEDDING_MODEL=
EMBEDDING_CACHE_MAX_ITEMS=
# Semantic match toggle + threshold (blank = config.py defaults).
SEMANTIC_MATCHING_ENABLED=
SEMANTIC_SIMILARITY_THRESHOLD=

# =============================================================================
# FILE STORAGE (blank = local backend + code defaults)
# STORAGE_BACKEND: local | gcs. GCS_* only needed when selected.
# =============================================================================
FILE_STORAGE_PATH=
STORAGE_BACKEND=
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
MAX_PARSE_TOKENS=
SKILL_TAXONOMY_PATH=
# Companion metadata written next to SKILL_TAXONOMY_PATH; blank = code default.
SKILL_TAXONOMY_METADATA_PATH=

# =============================================================================
# SKILL NORMALIZATION THRESHOLDS (two-pass; blank = config.py defaults)
# Pass 1: rapidfuzz WRatio 0-100. Pass 2: cosine similarity 0.0-1.0.
# =============================================================================
SKILL_FUZZY_THRESHOLD=
SKILL_SEMANTIC_THRESHOLD=

# =============================================================================
# PARSING THRESHOLDS (optional - tune accuracy)
# =============================================================================
LLM_CONFIDENCE_THRESHOLD=
CGPA_MISMATCH_THRESHOLD=
MAX_SUMMARY_SENTENCES=
MAX_UNKNOWN_SKILLS=
LONG_DOC_WORD_THRESHOLD=

# =============================================================================
# RECOMMENDATIONS (blank = config.py defaults)
# Live weights live in constants.py (JOB_RECOMMENDATION_WEIGHTS); only
# MAX_RECOMMENDATIONS is read from the environment.
# =============================================================================
MAX_RECOMMENDATIONS=

# =============================================================================
# RAG (blank = config.py defaults)
# RAG_PRELOAD_ON_STARTUP=false on 2GB boxes (RAG lazy-loads on first query).
# =============================================================================
RAG_PRELOAD_ON_STARTUP=
# Vector candidate pool bounds (blank = code defaults 200 / 20). Only relevant
# when a pgvector-backed retriever is configured; BM25+TF-IDF path ignores them.
VECTOR_RETRIEVAL_TOP_K=
VECTOR_RETRIEVAL_MIN_CANDIDATES=

# =============================================================================
# DEPLOY / PERFORMANCE FLAGS (single low-RAM compose profile)
# =============================================================================
DOCKER_HUB_USERNAME=
ASYNC_PARSE_ENABLED=
# GCP Secret Manager switch (container entrypoint only; never set locally).
# When set, resume_pipeline/docker-entrypoint.py pulls the documented secrets
# (PG_PASSWORD, SECRET_KEY, ADMIN_EMAIL, ADMIN_PASSWORD + optional API keys)
# from projects/$GCP_PROJECT/secrets/<NAME>/versions/latest before exec'ing
# uvicorn. When blank, the entrypoint execs straight through (local compose).
GCP_PROJECT=

# =============================================================================
# FRONTEND (Vite) - consumed via Vercel dashboard + docker build-args.
# Dev default: http://localhost:8000. No frontend/.env* files exist anymore.
# =============================================================================
VITE_API_URL=
VITE_API_BASE_URL=
